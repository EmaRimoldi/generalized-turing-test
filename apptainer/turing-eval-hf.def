Bootstrap: docker
From: python:3.11.15-slim-bookworm

%labels
    Author turing-eval-team
    Version 1.1.0
    Purpose Reproducible HF local-inference environment for the Turing ordering experiment runner

%files
    requirements.txt /opt/turing-eval/requirements.txt
    requirements-hf.txt /opt/turing-eval/requirements-hf.txt

%post
    set -eux
    apt-get update
    apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        curl
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip==26.2.2
    pip install --no-cache-dir -r /opt/turing-eval/requirements.txt -r /opt/turing-eval/requirements-hf.txt

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec "$@"

%test
    python --version
    python -c "import sys; assert sys.version_info[:3] == (3, 11, 15), sys.version_info"
    python -c "import torch, transformers, matplotlib"
    pytest --version
    ruff --version
