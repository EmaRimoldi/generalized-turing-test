{
  "name": "epsilon-visualizer-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:data": "python3 ../scripts/build_multicondition_visualizer_data.py",
    "predev": "npm run build:data",
    "dev": "vite",
    "prebuild": "npm run build:data",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "export:triple-png": "tsx scripts/save-triple-png.mts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "dagre": "^0.8.5",
    "katex": "^0.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
